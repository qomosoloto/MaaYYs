{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maa-yys.local/schema/custom.recognition.schema.json",
  "title": "MaaYYs Custom Recognitions",
  "description": "maa-yys-agent 注册的自定义识别器及 custom_recognition_param 参数约束。custom_recognition_param_code 由 MaaFramework 在运行时提供，使用它时不校验静态参数。",
  "type": "object",
  "properties": {
    "custom_recognition": {
      "type": "string",
      "enum": [
        "ConfigValueWriteRecognition",
        "ConfigValueCheckRecognition",
        "CoBattleTargetRecognition",
        "GuildBarrierTargetRecognition",
        "MyRecognizer",
        "OCRResultCounterRecognition",
        "TaskCounterRecognition"
      ]
    }
  },
  "if": { "required": ["custom_recognition"] },
  "then": {
    "oneOf": [
      { "$ref": "#/$defs/ConfigValueWriteRecognition" },
      { "$ref": "#/$defs/ConfigValueCheckRecognition" },
      { "$ref": "#/$defs/CoBattleTargetRecognition" },
      { "$ref": "#/$defs/GuildBarrierTargetRecognition" },
      { "$ref": "#/$defs/MyRecognizer" },
      { "$ref": "#/$defs/OCRResultCounterRecognition" },
      { "$ref": "#/$defs/TaskCounterRecognition" }
    ]
  },
  "$defs": {
    "RequiredParam": {
      "anyOf": [
        { "required": ["custom_recognition_param"] },
        { "required": ["custom_recognition_param_code"] }
      ]
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "ConfigValueWriteRecognition": {
      "title": "写入状态值",
      "description": "将值写入 assets/recognition_state.json，或执行加一、减一。",
      "allOf": [{ "$ref": "#/$defs/RequiredParam" }],
      "properties": {
        "custom_recognition": { "const": "ConfigValueWriteRecognition" },
        "custom_recognition_param": {
          "type": "object",
          "properties": {
            "key": { "$ref": "#/$defs/NonEmptyString", "description": "状态存储键" },
            "value": {
              "type": ["string", "number", "boolean", "null"],
              "default": null,
              "description": "写入值；add/+ /++/+1/inc/increase/plus 表示加 1，sub/-/--/-1/dec/decrease/minus 表示减 1"
            }
          },
          "required": ["key"],
          "additionalProperties": false
        }
      },
      "required": ["custom_recognition"]
    },
    "ConfigValueCheckRecognition": {
      "title": "检查状态值",
      "description": "把已存储的当前值与数字阈值比较；不存在的键按 0 处理。",
      "allOf": [{ "$ref": "#/$defs/RequiredParam" }],
      "properties": {
        "custom_recognition": { "const": "ConfigValueCheckRecognition" },
        "custom_recognition_param": {
          "type": "object",
          "properties": {
            "key": { "$ref": "#/$defs/NonEmptyString", "description": "状态存储键" },
            "value": {
              "oneOf": [
                { "type": "number" },
                { "type": "string", "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$" }
              ],
              "description": "用于比较的数字阈值"
            },
            "comparison": { "$ref": "#/$defs/Comparison", "description": "首选比较参数名" },
            "compare": { "$ref": "#/$defs/Comparison", "description": "comparison 的兼容别名" },
            "operator": { "$ref": "#/$defs/Comparison", "description": "comparison 的兼容别名" },
            "mode": { "$ref": "#/$defs/Comparison", "description": "comparison 的兼容别名" }
          },
          "required": ["key", "value"],
          "additionalProperties": false
        }
      },
      "required": ["custom_recognition"]
    },
    "Comparison": {
      "type": "string",
      "default": "<",
      "enum": [
        "<", "lt", "less", "小于",
        ">", "gt", "greater", "大于",
        "=", "==", "eq", "equal", "equals", "等于",
        "<=", "=<", "le", "lte", "less_equal", "less than or equal", "小于等于", "不大于",
        ">=", "=>", "ge", "gte", "greater_equal", "greater than or equal", "大于等于", "不小于",
        "!=", "<>", "ne", "neq", "not_equal", "not equal", "不等于"
      ]
    },
    "CoBattleTargetRecognition": {
      "title": "协战目标识别",
      "description": "维护进程内协战目标列表，或检查当前 OCR 目标是否在列表中。",
      "allOf": [{ "$ref": "#/$defs/RequiredParam" }],
      "properties": {
        "custom_recognition": { "const": "CoBattleTargetRecognition" },
        "custom_recognition_param": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["add", "check"],
              "description": "add：识别并加入目标；check：识别并检查目标"
            }
          },
          "required": ["action"],
          "additionalProperties": false
        }
      },
      "required": ["custom_recognition"]
    },
    "GuildBarrierTargetRecognition": {
      "title": "寮突破目标持续停留识别",
      "description": "按 Maa TaskID 隔离观察状态；进攻后仅被动截图，当同一玩家和进攻按钮持续存在时返回成功。",
      "allOf": [{ "$ref": "#/$defs/RequiredParam" }],
      "properties": {
        "custom_recognition": { "const": "GuildBarrierTargetRecognition" },
        "custom_recognition_param": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["reset", "observe", "result"],
              "description": "reset：开始新的观察窗口；observe：被动观察当前目标；result：识别并记录战斗结果"
            },
            "min_duration_ms": {
              "type": "integer",
              "minimum": 1,
              "default": 6000,
              "description": "同一目标至少持续存在的时间"
            },
            "min_observations": {
              "type": "integer",
              "minimum": 2,
              "default": 3,
              "description": "触发恢复前至少命中的连续观察次数"
            },
            "observation_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "default": 20000,
              "description": "单次进攻后的最大被动观察窗口"
            },
            "recognition_node": {
              "$ref": "#/$defs/NonEmptyString",
              "description": "result 动作委托执行的战斗结果识别节点"
            },
            "outcome": {
              "type": "string",
              "enum": ["success", "failure"],
              "description": "result 动作记录的战斗结果"
            },
            "log_prefix": {
              "$ref": "#/$defs/NonEmptyString",
              "default": "寮突破",
              "description": "用户可见日志前缀"
            },
            "require_target": {
              "type": "boolean",
              "default": false,
              "description": "reset 时是否要求玩家名与进攻按钮必须成对识别成功；未命中时返回识别失败"
            },
            "target_layouts": {
              "type": "array",
              "minItems": 1,
              "description": "reset 和 observe 使用的玩家名与进攻按钮配对布局；未提供时使用原版寮突破布局",
              "items": {
                "type": "object",
                "properties": {
                  "name_node": {
                    "$ref": "#/$defs/NonEmptyString",
                    "description": "玩家名 OCR 节点"
                  },
                  "attack_node": {
                    "$ref": "#/$defs/NonEmptyString",
                    "description": "同一布局的进攻按钮 OCR 节点"
                  },
                  "attack_center_x_min": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "进攻按钮中心点允许的最小横坐标（包含）"
                  },
                  "attack_center_x_max": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "进攻按钮中心点允许的最大横坐标（不包含）"
                  }
                },
                "required": ["name_node", "attack_node"],
                "additionalProperties": false
              }
            }
          },
          "required": ["action"],
          "additionalProperties": false
        }
      },
      "required": ["custom_recognition"]
    },
    "MyRecognizer": {
      "title": "占位识别器",
      "description": "不读取 custom_recognition_param，固定返回未识别。",
      "properties": { "custom_recognition": { "const": "MyRecognizer" } },
      "required": ["custom_recognition"]
    },
    "OCRResultCounterRecognition": {
      "title": "OCR best 结果计数器",
      "description": "运行指定 OCR 节点，统计 best 文本连续出现的次数；文本或节点变化时重新从 1 计数，达到目标次数后返回识别成功。",
      "allOf": [{ "$ref": "#/$defs/RequiredParam" }],
      "properties": {
        "custom_recognition": { "const": "OCRResultCounterRecognition" },
        "custom_recognition_param": {
          "type": "object",
          "properties": {
            "recognition_node": {
              "$ref": "#/$defs/NonEmptyString",
              "description": "要通过 context 运行的 OCR 识别节点名称"
            },
            "target_count": {
              "oneOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "string", "pattern": "^[1-9][0-9]*$" }
              ],
              "description": "同一个 best 文本需要连续出现的次数，支持整数或数字字符串"
            }
          },
          "required": ["recognition_node", "target_count"],
          "additionalProperties": false
        }
      },
      "required": ["custom_recognition"]
    },
    "TaskCounterRecognition": {
      "title": "识别调用计数器",
      "description": "按 TaskID 计数，达到目标后返回识别失败并清零。",
      "allOf": [{ "$ref": "#/$defs/RequiredParam" }],
      "properties": {
        "custom_recognition": { "const": "TaskCounterRecognition" },
        "custom_recognition_param": {
          "type": "object",
          "properties": {
            "target_count": {
              "oneOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "string", "pattern": "^\\{[^{}]+\\}$" }
              ],
              "description": "目标识别次数；interface pipeline_override 中也可使用 {变量名} 占位符"
            }
          },
          "required": ["target_count"],
          "additionalProperties": false
        }
      },
      "required": ["custom_recognition"]
    }
  }
}
